<?xml-stylesheet href="chrome://venkman/skin/venkman.css" type="text/css"?>

<window
  xmlns="http://www.mozilla.org/keymaster/gatekeeper/there.is.only.xul"
  orient="vertical" onload="onload();" height="300" width="200"
  persist="top left">
    <script>
      <![CDATA[
        var DEBUG = true;
      ]]>
