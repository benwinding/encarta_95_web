[Strings]
; ************************************************************************
; General strings
; ************************************************************************
APPS_DESC         = "Accessories"                                ; name of Start/Programs submenu
OLR_Link_Desc     = "Online Registration"                        ; Start menu shortcut (Online Registration)
MOS_DESC          = "The Microsoft Network"
MOS_TIP           = "Microsoft's online service (requires Windows Messaging and a modem)"
CallCard_Desc     = "Shortcut to The Microsoft Network"          ; MSN shortcut description
CallCardProp_Desc = "Properties for Shortcuts to The Microsoft Network"
Signup_Link_Desc  = "The Microsoft Network"                      ; Start menu shortcut (MSN Signup)
M8_Link_Desc      = "The Microsoft Network"                      ; Item on Start/Programs for M8 (was Signup_Link_Desc)
Old_Signup_Link_Desc = "Sign Up for The Microsoft Network"       ; M7 signup shortcut to delete
MSN_MAIL_DESC     = "The Microsoft Network Online Service"       ; Exchange profile, address book, service
MSN_Document      = "MSN Central"                                ; desktop icon description
BE_Install        = "MSN Setup Information"                      ; Installer document description ("MSN " + .INF description)
MSN_App_Extension = "MSN Application Extension"                  ; Description of .NAV and .NED files ("MSN " + .DLL description)
MSN_Phone_Book    = "MSN Phone Book"                             ; Description of .PBK files
Saved_MSN_Search  = "Saved MSN Search"                           ; Description of .MNF files (from .FND description "Saved Search")
MSN_Attached_File = "MSN Attached File"                          ; Description of BBS attachment objects
File_Desc         = "File"                                       ; Short description of BBS attachment

; ************************************************************************
; Menu commands
; These are used for the common OLE object and Shell command verbs.
; Ellipses, if required, are included here
; ************************************************************************
Menu_Open         = "&Open"
Menu_Properties   = "&Properties..."
Menu_Download     = "&Download"
Menu_Explore      = "&Explore"
Menu_Activate     = "&Activate"
Menu_Find         = "On The &Microsoft Network..."
Menu_Context_Find = "&Find..."

; ************************************************************************
; Directory names - note that that short versions must match the truncated
; 8 char names for the long versions
; ************************************************************************
Old_Program_Files= "Old Program Files"
OLD_PROGRAMF     = "Programf"
Program_Files    = "Program Files"
Start_Menu       = "Start Menu"
PROGRAMF         = "Progra~1"          ; first 6 chars of Program_Files, + "~1"
OEM_PROGRAMF     = "Progra~1"          ; first 6 chars of Program_Files, + "~1" - in OEM codepage (not Ansi)
THEMICRO         = "TheMic~1"          ; first 6 chars of The Microsoft Network, + "~1"
OEM_THEMICRO     = "TheMic~1"          ; first 6 chars of The Microsoft Network, + "~1"  - in OEM codepage (not Ansi)
OnlineShort       = "Online~1"
OnlineLong        = "Online Services"
MSN               = "MSN"              ; name of MSN dir under Online Services
Shared_Desktop   = "Desktop"
OEM_Shared_Desktop = "Desktop"
Download_Dir_Name = "Transferred Files"
