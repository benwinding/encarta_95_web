	(train archer-line)
	(set-goal secondary-build 0)
)

(defrule
	(population < unit-max)
	(can-train archer-line)
	(not (unit-available hand-cannoneer) )
	(or
		(goal combat-arm ARCHER)
		(goal pre-unique-arm ARCHER)
	)
=>
	(train archer-line)
	(set-goal secondary-build 0)
)

(defrule
	(goal secondary-build 0)
	(goal combat-supp ARCHER)
	(population < unit-max)
	(can-train archer-line)
