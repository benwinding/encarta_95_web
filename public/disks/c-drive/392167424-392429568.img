	(goal resource-needed FOOD)
	(current-age == feudal-age)
	(gold-amount > 400)
	(can-buy-commodity food)
	(commodity-buying-price food < 150)
=>
	(chat-local-to-self "use market for food")
	(release-escrow gold)
	(buy-commodity food)
)

(defrule
	(goal resource-needed GOLD)
	(current-age == feudal-age)
	(wood-amount > 300)
