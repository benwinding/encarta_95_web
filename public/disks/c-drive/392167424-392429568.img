;WONDERING
(defrule
	(goal wonder-attempt POSSIBLE)
	(wood-amount < 1000)
	(gold-amount > 1000)
	(stone-amount > 1000)
=>
	(set-goal resource-needed WOOD)
)

(defrule
	(goal wonder-attempt POSSIBLE)
	(wood-amount > 1000)
	(gold-amount < 1000)
	(stone-amount > 1000)
=>
	(set-goal resource-needed GOLD)
)

(defrule
	(goal wonder-attempt POSSIBLE)
	(wood-amount > 1000)
	(gold-amount > 1000)
	(stone-amount < 1000)
=>
	(set-goal resource-needed STONE)
)
