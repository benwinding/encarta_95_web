# messenger.properties
# mailnews.js
mailnews.start_page.url=chrome://messenger/content/start.xhtml
messenger.throbber.url=https://rn10950.github.io/RetroZillaWeb/
compose.throbber.url=https://rn10950.github.io/RetroZillaWeb/
