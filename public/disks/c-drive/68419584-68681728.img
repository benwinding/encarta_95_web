%Modem6%   = Modem6,   UNIMODEMCC646872                                                     ; Microcom DeskPorte FAST EP 28.8
%Modem5P%  = Modem5P,  "LPTENUM\MICROCOMDESKPORTE_28AF67"                                   ; Microcom DeskPorte FAST Parallel
