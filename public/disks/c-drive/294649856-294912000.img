Signature="$CHICAGO$"
[InstallControls]
ComponentName=IE40.Controls
AdvOptions=36
AddReg=RegControls,!RegRollbackControls
RequiredEngine=SETUPAPI,%ERR_NOSETUPAPI%
[UnInstallControls]
ComponentName=IE40.Controls
AdvOptions=260
RequiredEngine=SETUPAPI,%ERR_NOSETUPAPI%
[InstallBrowser]
ComponentName=IE40.Browser
AdvOptions=36
AddReg=RegBrowser,!RegRollbackBrowser
DelReg=DelRegBrowser
RequiredEngine=SETUPAPI,%ERR_NOSETUPAPI%
[UnInstallBrowser]
ComponentName=IE40.Browser
AdvOptions=260
RequireEngine=SETUPAPI,%ERR_NOSETUPAPI%
[InstallOnlyBrowser]
ComponentName=IE40.OnlyBrowser
AdvOptions=36
AddReg=RegOnlyBrowser,!RegRollbackOnlyBrowser
RequiredEngine=SETUPAPI,%ERR_NOSETUPAPI%
[UnInstallOnlyBrowser]
ComponentName=IE40.OnlyBrowser
AdvOptions=260
RequireEngine=SETUPAPI,%ERR_NOSETUPAPI%
[InstallShell]
ComponentName=IE40.Shell
AdvOptions=36
AddReg=RegShell,!RegRollbackShell
DelReg=DelRegShell,!DelRegShellIE4B2  ;; for IE40b2->RTW upgrade
RequiredEngine=SETUPAPI,%ERR_NOSETUPAPI%
[UnInstallShell]
ComponentName=IE40.Shell
AdvOptions=260
RequiredEngine=SETUPAPI,%ERR_NOSETUPAPI%
[InstallShellNT]
ComponentName=IE40.Shell
AdvOptions=36
AddReg=RegShellNT
RequiredEngine=SETUPAPI,%ERR_NOSETUPAPI%
[InstallShellNT5]
ComponentName=IE40.Shell
AdvOptions=36
AddReg=RegShellNT5
RequiredEngine=SETUPAPI,%ERR_NOSETUPAPI%
[InstallShellNT5Server]
ComponentName=IE40.Shell
AdvOptions=36
AddReg=RegShellNT5Server
RequiredEngine=SETUPAPI,%ERR_NOSETUPAPI%
[InstallAssociations]
ComponentName=IE40.Assoc
AdvOptions=36
AddReg=!RegRollbackAssociations
BackupReg=RegAssociations
RequiredEngine=SETUPAPI,%ERR_NOSETUPAPI%
[UnInstallAssociations]
ComponentName=IE40.Assoc
AdvOptions=260
RequiredEngine=SETUPAPI,%ERR_NOSETUPAPI%
[!RegRollbackControls]
HKLM,"Software\Microsoft\Advanced INF Setup\IE CompList","IE40.Controls",0,""
[!RegRollbackBrowser]
HKLM,"Software\Microsoft\Advanced INF Setup\IE CompList","IE40.Browser",0,""
[!RegRollbackOnlyBrowser]
HKLM,"Software\Microsoft\Advanced INF Setup\IE CompList","IE40.OnlyBrowser",0,""
[!RegRollbackShell]
HKLM,"Software\Microsoft\Advanced INF Setup\IE CompList","IE40.Shell",0,""
[!RegRollbackAssociations]
HKLM,"Software\Microsoft\Advanced INF Setup\IE CompList","IE40.Assoc",0,""
[RegControls]
[DelRegBrowser]
HKCR,"CLSID\%CLSID_WebBrowser1%\Control"
[RegBrowser]
HKCR,"CLSID\%CLSID_Shell%",,,"%DESC_ShellApp%"
