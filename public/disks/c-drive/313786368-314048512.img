console.doEval =
function con_eval(__s, __o)
{
    var __ex;
    var rv;
    
    try
    {
        if (__o)
        {
            rv = eval(__s, __o);
        }
        else
        {
            rv = eval(__s);
        }
    }
    catch (__ex)
    {
        dd ("doEval caught: " + __ex);
        
        if (__ex && typeof __ex == "object" && "fileName" in __ex &&
            __ex.fileName.search (/venkman-eval.js$/) != -1)
        {
            __ex.fileName = MSG_VAL_CONSOLE;
            __ex.lineNumber = console.evalCount;
        }
        ++console.evalCount;
        throw __ex;
    }

    ++console.evalCount;
    return rv;
}

