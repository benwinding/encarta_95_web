     load_file = async function(filename, options, n_tries)
     {
+        if(options.synchronous)
+        {
+            var http = new XMLHttpRequest();
+            http.open(options.method || "get", filename, false);
+            if(!options.as_json) { http.overrideMimeType("text/plain; charset=x-user-defined"); }
+            if(options.headers) { for(var k in options.headers) http.setRequestHeader(k, options.headers[k]); }
+            if(options.range)
+            {
+                var s = options.range.start, e = s + options.range.length - 1;
+                http.setRequestHeader("Range", "bytes=" + s + "-" + e);
+                http.setRequestHeader("X-Accept-Encoding", "identity");
+            }
+            http.send();
+            if(http.status === 200 || http.status === 206)
+            {
+                if(options.as_json) { options.done(JSON.parse(http.responseText)); }
+                else
+                {
+                    var text = http.responseText;
+                    var out = new Uint8Array(text.length);
+                    for(var i = 0; i < text.length; i++) out[i] = text.charCodeAt(i) & 0xFF;
+                    options.done(out.buffer);
+                }
+            }
+            else { console.error("Loading the image " + filename + " failed (status %d)", http.status); }
+            return;
+        }
