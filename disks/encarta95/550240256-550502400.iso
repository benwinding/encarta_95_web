roller  -- sprites needed for background and buttons of controller  global PanelHt, PanelWd, StageHt, StageWd  global LastButton         -- string indicating last button that was pressed  global ButWd              -- width of an individual button  global ClickedOnClose     -- should be initialized to FALSE  set Panel = 23            -- reserve channel 23 for Panel QD rectangle  set Controller = 24       -- reserve channel 24 for button bitmaps (cast H12, H13, H14, H15)   set PanelHt = 28          -- height of control panel  set ButWd = 19            -- width of an individual button  -- NOTE: the pixel width of the StepBack, StepFwd, Stop and play buttons are each 19  -- If the bitmaps for the controller are changed, the values below  -- must be changed accordingly.  set ClickedOnClose = FALSE  PositionPanel  puppetSprite Controller, TRUE               -- Control channel 24 from Lingo  set the type of sprite Controller to 1      -- type 1 is bitmap  set LastButton = "Play"   -- operate as if person has already clicked on Play button  continue                  -- movie should begain playing automatically, by default  set the castNum of sprite Controller to Â    the number of cast "AllUpPause" -- bitmap with all buttons up, including Pause  set the locH of sprite Controller to StageWd - 118   set the locV of sprite Controller to StageHt - PanelHt + 6  updateStage  when mouseDown then doMouseDown  when mouseUp then doMouseUpend InitController-- draw the background rectangle for the controlleron PositionPanel  global Panel, Controller  -- sprites needed for background and buttons of controller  global PanelHt, PanelWd, StageHt, StageWd  set stageBottom = the stageBottom + PanelHt  -- expand vertically to accomodate controller  set PanelWd = (the stageRight - the stageLeft)  puppetSprite Panel, TRUE  set the type of sprite Panel to 2                   -- QuickDraw rectangle  set the castNum of sprite Panel to the number of cast "PanelRect"  set the foreColor of sprite Panel to 13             -- light gray in Mercury palette  set StageHt = the stageBottom - the stageTop        -- determine current stage height  set StageWd = the stageRight - the stageLeft        -- determine current stage width  set the locV of sprite Panel to (StageHt - PanelHt) -- Panel directly beneath anim  set the locH of sprite Panel to 0                   -- Panel extends to left edge of stage  set the height of sprite Panel to PanelHt  set the width of sprite Panel to PanelWdend PositionPanelon startMovie  SetColorDepth  InitControllerend startMovie-- save the current color depth and switch to 16-colors if necessaryon SetColorDepth  global InitialColorDepth  set the switchColorDepth to FALSE  if the colorQD then    set InitialColorDepth = the colorDepth    if InitialColorDepth <> 4 then      set the colorDepth = 4    else      nothing    end if  else    alert "Animations require a color Macintosh."    quit  end ifend SetColorDepth-- reset to original color depth if necessaryon ResetColorDepth  global InitialColorDepth  if the colorDepth <> InitialColorDepth then    set the colorDepth = InitialColorDepth  end ifend ResetColorDepthon doMouseDown  DepressButtonend doMouseDownon doMouseUp  TakeAction  ReleaseButtonend doMouseUp-- cleanup after movieon Cleanup  global Panel, Controller         -- sprites needed for background and buttons of controller  ResetColorDepth  puppetSprite Panel, FALSE        -- turn off Panel  puppetSprite Controller, FALSE   -- turn off Controller  when mouseDown then nothing  when mouseUp then nothing  quitend Cleanup-- handler called by mouseDown Cast Scripts for controller bitmapson DepressButton  global Controller        -- sprites needed for buttons of controller  global LastButton        -- indicates last button clicked  global ClickedOnClose  set ClickedOnClose = FALSE  set Button = ButtonNum() -- obtain integer for button clicked on  if Button <> 0 then    puppetSound 0            -- turn off any sound that may be playing    puppetTransition 0       -- abort any transition that may be going on now  end if  startTimer  if Button = 1 then    pause                  set LastButton = "StepRev"    set the castNum of sprite Controller to Â      the number of cast "StepRevDown"    updateStage  else if Button = 2 then    pause                  set LastButton = "StepFwd"     set the castNum of sprite Controller to Â      the number of cast "StepFwdDown"    updateStage  else if Button = 3 then    pause                  set LastButton = "Stop"    set the castNum of sprite Controller to Â      the number of cast "StopDown"  else if Button = 4 then    if the pauseState = TRUE then      set LastButton = "Play"      set the castNum of sprite Controller to Â        the number of cast "PlayDown"      continue    else      pause                    set LastButton = "Pause"      set the castNum of sprite Controller to Â        the number of cast "PauseDown"    end if  else if Button = 5 then    pause                  set LastButton = "Close"    set ClickedOnClose = TRUE    set the castNum of sprite Controller to Â      the number of cast "CloseDown"  else    set LastButton = "None"  end if  updateStage  Fastend DepressButton-- this handler enables fast forward and fast reverse by 8-frame increments-- when the StepFwd or StepRev buttons are held down for more than 30 ticks (0.5 seconds)on Fast  global LastButton  -- the last button clicked  global Controller  puppetTransition 0 -- abort any transition that may be going on now  if LastButton = "StepRev" then    repeat while the stillDown      if (not rollOver(Controller)) then        ReleaseButton        exit      else        if the timer > 30 then          if the frame > 8 then             go to the frame - 8          else            go to frame 1          end if          pause        end if      end if    end repeat  else if LastButton = "StepFwd" then    repeat while the stillDown      if (not rollOver(Controller)) then        ReleaseButton        exit      else        if the timer > 30 then          if the frame < label("end") - 8 then             go to the frame + 8          else            go to frame label("end")          end if          pause        end if      end if    end repeat  else if LastButton = "Stop" then    WaitForRelease  else if LastButton = "Pause" then    WaitForRelease  else if LastButton = "Play" then    WaitForRelease  else if LastButton = "Close" then    WaitForRelease  else    exit  end ifend Fast-- handler called by Fast to deal with mouse released or sliding off buttonon WaitForRelease  global Controller  repeat while the stillDown    if (not rollOver(Controller)) then      ReleaseButton      exit    end if  end repeatend WaitForRelease-- handler called by doMouseUp handleron ReleaseButton  global Controller  -- sprites needed for background and buttons of controller  global LastButton  -- the last button clicked  if the pauseState = TRUE then    set the castNum of sprite Controller to Â    the number of cast "AllUpPlay" -- bitmap with all buttons up, including Play  else      set the castNum of sprite Controller to Â    the number of cast "AllUpPause" -- bitmap with all buttons up, including Pause  end if  updateStageend ReleaseButton-- handler called by doMouseUp handleron TakeAction  global Controller  -- sprites needed for background and buttons of controller  global LastButton  -- the last button clicked  global ClickedOnClose  if ClickedOnClose then    if ButtonNum() = 5 then      Cleanup    end if  else    set ClickedOnClose = FALSE  end if  if LastButton = "StepRev" then    if the frame > 1 then       go to the frame - 1      pause    end if  else if LastButton = "StepFwd" then    if the frame < label("end") - 1 then       go to the frame + 1      pause    end if  else if LastButton = "Stop" then    go to frame 1    pause  else if LastButton = "Pause" then    pause  else if LastButton = "Play" then    continue      else if LastButton = "Close" then    set ClickedOnClose = TRUE  end ifend TakeAction-- function returning number of button clickedon ButtonNum  global Controller  -- sprites needed for background and buttons of controller  global ButWd  set RelX to (the mouseH - the left of sprite Controller)  if the mouseCast = the castNum of sprite Controller then    if RelX > 4*ButWd then       set B to 5  -- click on Close button    else       set B to integer(RelX/ButWd + 1)      -- 1 = StepRev      -- 2 = StepFwd      -- 3 = Stop      -- 4 = Play/Pause      -- 5 = Close    end if    return B  else    return 0  -- not on a button  end ifend ButtonNum-- called by score scripts in frames where animation should wait for audio to finishon WaitForSound  repeat while soundBusy(1)              -- check whether sound is playing in audio channel 1    if (the mouseDown) or (the stillDown) then exit repeat  -- need to stop the sound when any button is pressed  end repeatend WaitForSound-- called by score script in last frame of animationon GoBack  global Controller  go to frame 1  pause  set the castNum of sprite Controller to Â    the number of cast "AllUpPlay" -- bitmap with all buttons up, including Play  updateStageend GoBackJayleen Ryberg - Microsoft␀␀vwlbM␀␀␀␀␀␀␀4␀␀␀␀␀␀␀␀A␀)B␀*␀␀␀-$ Introduction#$ How a refrigerator works#end␀vwacs␀␀␀␀␀␀4␀␀␀␀8␀Z␀€␀§␀Î␀õ	
