[Modem2]    ; Envoy (9600 baud)
AddReg=All, MfgAddReg, Modem2.AddReg, INTERNAL

[Modem1]    ; Envoy Internal card (14400 baud)
AddReg=All, MfgAddReg, Modem1.AddReg, INTERNAL

