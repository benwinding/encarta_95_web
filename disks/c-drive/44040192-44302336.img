"Access"="Read-Only"
"Storage"="Common"
"Type"="Enum"
":0"="HKLM\\DesktopManagement\\DATA\\%ComponentID\\802AlternateAddress\\AddressType"
"!0"="B;IN(0,1)(1,2)(2,3)"

