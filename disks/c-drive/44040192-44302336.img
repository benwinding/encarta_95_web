"Column"="4"
"Access"="Read-Only"
"Storage"="Common"
"Type"="Enum"
":0"="HKLM\\DesktopManagement\\DATA\\2\\SystemSlots\\CurrentUsage"

[HKEY_LOCAL_MACHINE\DesktopManagement\MIF\2\19\4\Enum]
