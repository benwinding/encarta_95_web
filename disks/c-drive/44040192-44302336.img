"Description"="The manufacturer's serial number for this Field Replaceable Unit."
"Column"="7"
"Access"="Read-Only"
"Storage"="Common"
"Type"="DisplayString(64)"
":0"="HKLM\\DesktopManagement\\DATA\\2\\FRU\\FRUSerialNumber"

[HKEY_LOCAL_MACHINE\DesktopManagement\MIF\2\30\8]
"Name"="Revision Level"
"Description"="The revision level of this Field Replaceable Unit."
"Column"="8"
"Access"="Read-Only"
"Storage"="Common"
"Type"="DisplayString(64)"
":0"="HKLM\\DesktopManagement\\DATA\\2\\FRU\\RevisionLevel"

[HKEY_LOCAL_MACHINE\DesktopManagement\MIF\2\30\9]
"Name"="Warranty Start Date"
"Description"="The start date of the service warranty for this Field Replaceable Unit."
"Column"="9"
"Access"="Read-Only"
"Storage"="Specific"
"Type"="Date"
":0"="HKLM\\DesktopManagement\\DATA\\2\\FRU\\WarrantyStartDate"

[HKEY_LOCAL_MACHINE\DesktopManagement\MIF\2\30\10]
