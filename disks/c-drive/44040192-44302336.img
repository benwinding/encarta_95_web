"Class"="DMTF|System Resources|001"
"Description"="The System Resources group contains hardware descriptions which are commonly used on PC style computers such as IRQs, IO ports, and memory address ranges."
"Key"="1,2"
"^INDEX"=dword:00000003
"^ROW"="1|^ROWNUM|3|4|5|6|7"

[HKEY_LOCAL_MACHINE\DesktopManagement\Install\Defaults\MIF\Net\%ComponentID\3\1]
"Name"="Device ID"
"Description"="On systems that implement a PnP-like subsystem, the
device ID should be the ID used by that subsystem. On systems that do
not have inherent device numbering, then the instrumentation supporting
the system resources group should devise a device number scheme. In
either case, the table will naturally group all of the resources
associated with a device."
"Column"="1"
"Access"="Read-Only"
"Storage"="Common"
"Type"="Integer"
;  Default value - all resources are for the current component (NIC)
"Value"="1"

[HKEY_LOCAL_MACHINE\DesktopManagement\Install\Defaults\MIF\Net\%ComponentID\3\2]
"Name"="Resource Number"
"Description"="This attribute is the ordinal of the resource within a
device. Within the table, any device may have one or more resources."
"Column"="^ROWNUM"
"Access"="Read-Only"
"Storage"="Common"
"Type"="Integer"

[HKEY_LOCAL_MACHINE\DesktopManagement\Install\Defaults\MIF\Net\%ComponentID\3\3]
"Name"="Resource Type"
"Description"="The type of system resource represented by this entry."
"Column"="3"
"Access"="Read-Only"
"Storage"="Common"
"Type"="Enum"
":0"="HKLM\\DesktopManagement\\DATA\\%ComponentID\\Resources\\ResourceType"
"!0"="B;IN(1,3)(2,4)(3,6)(4,5)"
;  			Instr enum
;  Memory range		1
;  I/O port			2
;  DMA			3
;  IRQ			4

[HKEY_LOCAL_MACHINE\DesktopManagement\Install\Defaults\MIF\Net\%ComponentID\3\3\Enum]
"1"="Other"
"2"="Unknown"
"3"="Memory Range"
"4"="I/O Port"
"5"="IRQ"
"6"="DMA"

[HKEY_LOCAL_MACHINE\DesktopManagement\Install\Defaults\MIF\Net\%ComponentID\3\4]
"Name"="Resource Base"
"Description"="The starting address of the system resource in the
appropriate address space."
"Column"="4"
"Access"="Read-Only"
"Storage"="Common"
"Type"="Integer"
":0"="HKLM\\DesktopManagement\\DATA\\%ComponentID\\Resources\\ResourceBase"

[HKEY_LOCAL_MACHINE\DesktopManagement\Install\Defaults\MIF\Net\%ComponentID\3\5]
"Name"="Resource Size"
"Description"="The size of the system resource."
"Column"="5"
"Access"="Read-Only"
"Storage"="Common"
"Type"="Integer"
":0"="HKLM\\DesktopManagement\\DATA\\%ComponentID\\Resources\\ResourceSize"

[HKEY_LOCAL_MACHINE\DesktopManagement\Install\Defaults\MIF\Net\%ComponentID\3\6]
"Name"="Resource Flags"
"Description"="This attribute contains fields representing the status of
this resource entry.  The meaning of this field varies according to the
Resource Type field in this group."
"Column"="6"
"Access"="Read-Only"
"Storage"="Common"
"Type"="Integer"
"Value"=hex:00

[HKEY_LOCAL_MACHINE\DesktopManagement\Install\Defaults\MIF\Net\%ComponentID\3\7]
"Name"="Group ID"
"Description"="This attribute is a 'back pointer' to a group within this
MIF, if applicable.  If the back pointer is not known, either because
the device is not represented by a group, or the actual device type is
