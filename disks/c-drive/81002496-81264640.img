uv_vectors {
nx*ny,
#local i=0;
#while (i<nx)
  #local j=0;
  #while (j<ny)
    #if((j < ny-1) & (i < nx-1))
      <i/(nx-1), j/(ny-1)>,
    #else
      <i/(nx-1), j/(ny-1)>
    #end
    #local j=j+1;
  #end
  #local i=i+1;
#end
}
face_indices {
15842
#local i=0;
#while (i<nx)
  #local j=0;
  #while (j<ny)
    #if (((j+1) <= (ny-1)) & ((i+1) <= (nx-1)))
      <i*ny+j, i*ny+j+1, (i+1)*ny+j>
    #end
    #if (((j-1) >= 0) & ((i-1) >= 0))
      <i*ny+j, i*ny+j-1, (i-1)*ny+j>
    #end
    #local j=j+1;
  #end
  #local i=i+1;
#end
}
