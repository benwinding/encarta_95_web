            if (!this.screenLeft || !this.screenTop) {
              this.screenLeft = aEvent.screenX; 
              this.screenTop = aEvent.screenY;
            }
            var deltaX = aEvent.screenX - this.screenLeft;
            var deltaY = aEvent.screenY - this.screenTop;
