            this.screenTop = aEvent.screenY;
            var currWidth = aEvent.target.boxObject.width;
            var currHeight = aEvent.target.boxObject.height;
            aEvent.target.sizeTo(currWidth + deltaX, currHeight + deltaY);
          }
