; SHELL32.DLL structures and constants

struct NOTIFYICONDATA
  cbSize	   dd ?,?
  hWnd		   dq ?
  uID		   dd ?
  uFlags	   dd ?
  uCallbackMessage dd ?,?
  hIcon 	   dq ?
  szTip 	   TCHAR 64 dup (?)
ends

struct NOTIFYICONDATAA
  cbSize	   dd ?,?
  hWnd		   dq ?
  uID		   dd ?
  uFlags	   dd ?
  uCallbackMessage dd ?,?
  hIcon 	   dq ?
  szTip 	   db 64 dup (?)
ends

struct NOTIFYICONDATAW
  cbSize	   dd ?,?
  hWnd		   dq ?
  uID		   dd ?
  uFlags	   dd ?
  uCallbackMessage dd ?,?
  hIcon 	   dq ?
  szTip 	   du 64 dup (?)
ends

struct BROWSEINFO
  hwndOwner	 dq ?
  pidlRoot	 dq ?
  pszDisplayName dq ?
  lpszTitle	 dq ?
  ulFlags	 dd ?,?
  lpfn		 dq ?
  lParam	 dq ?
  iImage	 dq ?
ends

; Taskbar icon messages

NIM_ADD        = 0
NIM_MODIFY     = 1
NIM_DELETE     = 2
NIM_SETFOCUS   = 3
NIM_SETVERSION = 4

; Taskbar icon flags

NIF_MESSAGE    = 01h
NIF_ICON       = 02h
NIF_TIP        = 04h
NIF_STATE      = 08h
NIF_INFO       = 10h
NIF_GUID       = 20h

