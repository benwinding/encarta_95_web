    color: #0000FC;
}

.chatzilla-fg13 {
    color: #FF00FF;
}

.chatzilla-fg14 {
    color: #7F7F7F;
}

.chatzilla-fg15 {
    color: #D2D2D2;
}

.chatzilla-bg00 {
    background-color: #FFFFFF;
}

