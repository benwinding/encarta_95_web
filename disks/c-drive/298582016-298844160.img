  <xsl:when test="normalize-space(.)">
   <li><xsl:apply-templates select="."/></li>
  </xsl:when>
  <xsl:otherwise>
   <li style="color:red">&p3p.purpose.other;</li>
  </xsl:otherwise>
 </xsl:choose>
</xsl:template>

<!-- REMEDIES -->
