  <xsl:when test="normalize-space(.)">
   <li><xsl:apply-templates select="."/></li>
  </xsl:when>
  <xsl:otherwise>
   <li>&p3p.categories.other;</li>
  </xsl:otherwise>
 </xsl:choose>
