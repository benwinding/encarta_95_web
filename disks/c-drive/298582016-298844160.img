 <li>&p3p.categories.financial;</li>
</xsl:template>

<xsl:template mode="CATEGORIES" match="p3p:computer">
 <li>&p3p.categories.computer;</li>
</xsl:template>

<xsl:template mode="CATEGORIES" match="p3p:navigation">
 <li>&p3p.categories.navigation;</li>
</xsl:template>

