 </li>
 <xsl:if test = ".[@required='opt-in']">
  <xsl:call-template name="optin"/>
 </xsl:if>
 <xsl:if test = ".[@required='opt-out']">
  <xsl:call-template name="optout"/>
 </xsl:if>
</xsl:template>

