␀␀␀␀␀yWNÅ_´␀␀´␀␀␀␀␀content/global/printProgress.js/* -*- Mode: C; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 2 -*- */
/* ***** BEGIN LICENSE BLOCK *****
